import speech_recognition as sr
import pyttsx3
from plyer import notification
import time
from datetime import datetime

# Initialize the speech engine
engine = pyttsx3.init()

def speak(text):
    engine.say(text)
    engine.runAndWait()

def listen():
    recognizer = sr.Recognizer()
    with sr.Microphone() as source:
        print("Listening...")
        speak("I'm listening")
        audio = recognizer.listen(source)
        try:
            text = recognizer.recognize_google(audio)
            print(f"You said: {text}")
            return text
        except sr.UnknownValueError:
            speak("Sorry, I didn't get that.")
            return None
        except sr.RequestError:
            speak("Sorry, service is unavailable.")
            return None

def parse_time(time_str):
    try:
        return datetime.strptime(time_str, "%H:%M")
    except ValueError:
        return None

# Main flow
speak("Say your note.")
note = listen()

speak("At what time should I remind you? Say the time in 24 hour format like 14:30.")
time_input = listen()

reminder_time = parse_time(time_input)

if note and reminder_time:
    speak(f"Reminder set for {reminder_time.strftime('%H:%M')}. I will notify you.")
    while True:
        now = datetime.now()
        if now.hour == reminder_time.hour and now.minute == reminder_time.minute:
            notification.notify(
                title="Reminder",
                message=note,
                timeout=10
            )
            speak("Here is your reminder.")
            break
        time.sleep(30)
else:
    speak("Sorry, there was a problem setting your reminder.")
